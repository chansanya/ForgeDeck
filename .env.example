# Light DevOps Docker Compose 生产配置模板；部署前替换全部占位凭据。

# 运行环境；production 拒绝占位密码和占位 Token。
DEVOPS_ENVIRONMENT=production

# 数据库连接串；容器内 SQLite 路径。
DEVOPS_DATABASE_URL=sqlite+aiosqlite:////var/lib/devops/devops.db

# 生产环境关闭自动建表，统一使用 Alembic 迁移。
DEVOPS_AUTO_CREATE_SCHEMA=false

# 应用数据目录（SQLite、工作区）。
DEVOPS_DATA_DIR=/var/lib/devops

# Fernet 主密钥文件路径；不可丢失，必须与数据库分开备份。
DEVOPS_SECRET_KEY_PATH=/run/secrets/devops/master.key

# 流水线 JSONL 日志目录。
DEVOPS_LOG_DIR=/var/log/devops

# Runner checkout 和构建工作区目录。
DEVOPS_WORKSPACE_DIR=/var/lib/devops/workspaces

# 单管理员用户名。
DEVOPS_ADMIN_USERNAME=admin

# 首次启动引导密码；首次登录后删除此项。
DEVOPS_ADMIN_INITIAL_PASSWORD=replace-on-first-start

# Web 登录访问令牌有效期（分钟）。
DEVOPS_ACCESS_TOKEN_MINUTES=30

# MCP 允许的 Host 列表，逗号分隔。
DEVOPS_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,devops.local,devops.local:*

# MCP 允许的浏览器 Origin 列表，逗号分隔。
DEVOPS_MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://devops.local,https://devops.local:*

# API 与 Runner 内部认证 Token，至少 32 字符且两端完全一致。
DEVOPS_INTERNAL_TOKEN=replace-with-another-dedicated-long-random-token

# API 访问 Runner 内部接口的地址。
DEVOPS_RUNNER_INTERNAL_URL=http://127.0.0.1:8765

# Runner 实例标识；未设置时自动生成。
DEVOPS_RUNNER_ID=runner-local

# Runner 空闲轮询间隔（秒）。
DEVOPS_RUNNER_POLL_SECONDS=1

# 任务租约时长（秒）；过期未续约的任务会被回收。
DEVOPS_RUNNER_LEASE_SECONDS=60

# 主机指标采集周期（秒）。
DEVOPS_METRICS_INTERVAL_SECONDS=30

# 流水线日志保留天数。
DEVOPS_RUN_LOG_RETENTION_DAYS=30

# 审计记录保留天数。
DEVOPS_AUDIT_RETENTION_DAYS=180

# 允许访问 API 的浏览器 Origin 列表；空数组表示由反代控制。
DEVOPS_CORS_ORIGINS=[]

# API 托管的前端 dist 目录。
DEVOPS_FRONTEND_DIR=/app/frontend/dist
