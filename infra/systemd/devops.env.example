# Light DevOps systemd 生产配置模板；部署前替换全部占位凭据。
# 运行环境；production 模式下：禁止设置 MCP_TOKEN、必须配置 INTERNAL_TOKEN、
# 密码和 Token 不得使用 replace-* 等占位值，否则进程拒绝启动。
DEVOPS_ENVIRONMENT=production
DEVOPS_DATABASE_URL=sqlite+aiosqlite:////var/lib/light-devops/devops.db
DEVOPS_AUTO_CREATE_SCHEMA=false
DEVOPS_DATA_DIR=/var/lib/light-devops
DEVOPS_SECRET_KEY_PATH=/etc/light-devops/master.key
DEVOPS_LOG_DIR=/var/log/light-devops
DEVOPS_WORKSPACE_DIR=/var/lib/light-devops/workspaces
DEVOPS_ADMIN_USERNAME=admin
DEVOPS_ADMIN_INITIAL_PASSWORD=replace-on-first-start
DEVOPS_ACCESS_TOKEN_MINUTES=30
DEVOPS_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,devops.local,devops.local:*
DEVOPS_MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://devops.local,https://devops.local:*
DEVOPS_INTERNAL_TOKEN=replace-with-another-dedicated-long-random-token
DEVOPS_RUNNER_INTERNAL_URL=http://127.0.0.1:8765
DEVOPS_RUNNER_ID=runner-local
DEVOPS_RUNNER_POLL_SECONDS=1
DEVOPS_RUNNER_LEASE_SECONDS=60
DEVOPS_METRICS_INTERVAL_SECONDS=30
DEVOPS_RUN_LOG_RETENTION_DAYS=30
DEVOPS_AUDIT_RETENTION_DAYS=180
DEVOPS_CORS_ORIGINS=[]
DEVOPS_FRONTEND_DIR=/opt/light-devops/frontend/dist
