# 以 docker 组成员运行执行面；内部 API 只监听回环地址。
[Unit]
Description=Light DevOps Runner
After=network-online.target docker.service devops-api.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=devops-runner
Group=light-devops
SupplementaryGroups=docker light-devops
WorkingDirectory=/opt/light-devops/backend
EnvironmentFile=/etc/light-devops/devops.env
Environment=DEVOPS_INTERNAL_HOST=127.0.0.1
UMask=0007
ExecStart=/opt/light-devops/backend/.venv/bin/python -m devops.runner.main
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/light-devops /var/log/light-devops

[Install]
WantedBy=multi-user.target
