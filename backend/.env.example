# Light DevOps 后端本地开发配置模板。
# 复制为 .env 并替换所有 replace-* 占位值后使用。
# 带默认值的变量可省略；此处全部列出供参考。

# ── 基础 ──────────────────────────────────────────────
# 运行环境；development（默认）或 production。
# production 模式下：禁止设置 MCP_TOKEN、必须配置 INTERNAL_TOKEN、
# 密码和 Token 不得使用 replace-* 等占位值，否则进程拒绝启动。
#DEVOPS_ENVIRONMENT=development
# 应用名称，显示在 OpenAPI 文档标题。
#DEVOPS_APP_NAME=Light DevOps
# REST API 前缀。
#DEVOPS_API_PREFIX=/api/v1

# ── 数据库与存储 ──────────────────────────────────────
# 数据库连接串；v1 正式生产只支持 SQLite。
DEVOPS_DATABASE_URL=sqlite+aiosqlite:///./data/devops.db
# 开发环境自动建表；生产应使用 Alembic 迁移并设为 false。
#DEVOPS_AUTO_CREATE_SCHEMA=true
# 应用数据目录（SQLite、配置快照）。
#DEVOPS_DATA_DIR=./data
# 流水线 JSONL 日志目录。
#DEVOPS_LOG_DIR=./logs
# Runner checkout 和构建工作区目录。
#DEVOPS_WORKSPACE_DIR=./data/workspaces
# API 托管的前端 dist 目录；为空则不托管前端。
#DEVOPS_FRONTEND_DIR=../frontend/dist
# API 读取项目模板的目录。
#DEVOPS_TEMPLATE_DIR=../templates

# ── 安全与认证 ────────────────────────────────────────
# Fernet 主密钥文件路径；首次启动自动生成，不可丢失，必须与数据库分开备份。
DEVOPS_SECRET_KEY_PATH=./secrets/master.key
# JWT 签发方标识。
#DEVOPS_JWT_ISSUER=light-devops
# Web 登录访问令牌有效期（分钟）。
#DEVOPS_ACCESS_TOKEN_MINUTES=30
# 单管理员用户名。
DEVOPS_ADMIN_USERNAME=admin
# 首次启动引导密码，至少 12 字符；首次登录后应删除此项。
DEVOPS_ADMIN_INITIAL_PASSWORD=replace-with-at-least-12-characters
# API 与 Runner 内部认证 Token，至少 32 字符且两端完全一致。
DEVOPS_INTERNAL_TOKEN=replace-with-a-dedicated-long-random-token

# ── API 与网络 ────────────────────────────────────────
# 允许访问 API 的浏览器 Origin 列表，支持 JSON 数组或逗号分隔。
DEVOPS_CORS_ORIGINS=["http://localhost:5173"]

# ── Runner ────────────────────────────────────────────
# API 访问 Runner 内部接口的地址。
DEVOPS_RUNNER_INTERNAL_URL=http://127.0.0.1:8765
# Runner 内部 API 监听地址；生产应保持 127.0.0.1。
#DEVOPS_INTERNAL_HOST=127.0.0.1
# Runner 内部 API 监听端口。
#DEVOPS_INTERNAL_PORT=8765
# Runner 实例标识；未设置时自动生成"主机名:PID:随机串"。
#DEVOPS_RUNNER_ID=
# Runner 空闲轮询间隔（秒）。
#DEVOPS_RUNNER_POLL_SECONDS=1
# 任务租约时长（秒）；过期未续约的任务会被回收。
#DEVOPS_RUNNER_LEASE_SECONDS=60
# 任务租约心跳间隔（秒）；必须短于租约时长。
#DEVOPS_RUNNER_HEARTBEAT_SECONDS=
# Runner 日志级别。
#DEVOPS_LOG_LEVEL=INFO

# ── 指标采集 ──────────────────────────────────────────
# 主机指标采集周期（秒）。
#DEVOPS_METRICS_INTERVAL_SECONDS=30

# ── 日志与维护 ────────────────────────────────────────
# 流水线日志保留天数。
#DEVOPS_RUN_LOG_RETENTION_DAYS=30
# 审计记录保留天数。
#DEVOPS_AUDIT_RETENTION_DAYS=180

# ── SSE 日志流 ────────────────────────────────────────
# SSE 查询新日志的轮询间隔（秒）。
#DEVOPS_SSE_POLL_INTERVAL_SECONDS=0.5
# SSE 单次读取事件上限。
#DEVOPS_SSE_BATCH_SIZE=200

# ── MCP ───────────────────────────────────────────────
# 是否挂载 /mcp 端点。
#DEVOPS_MCP_ENABLED=true
# MCP 引导 Token（仅开发用；生产环境从 Web 控制台签发短期 Token）。
#DEVOPS_MCP_TOKEN=
# MCP 允许的 Host 列表，逗号分隔。
#DEVOPS_MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
# MCP 允许的浏览器 Origin 列表，逗号分隔。
#DEVOPS_MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
